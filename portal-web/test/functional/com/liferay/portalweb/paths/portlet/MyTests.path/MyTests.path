<html>
<head>
<title>MyTests</title
</head>

<body>
<table border="1" cellpadding="1" cellspacing="1">
<thead>
<tr><td rowspan="1" colspan="3">MyTests</td></tr>
</thead>

<tbody>

<tr>
	<td>CONFIGURATION</td>
	<td>//*[@id="nav_control_panel.configuration"]</td>
	<td></td>
</tr>
<tr>
	<td>CLOSE_SIMULATION</td>
	<td>//button[@aria-label='Close']</td>
	<td></td>
</tr>
<tr>
	<td>ALERT</td>
	<td>*[contains(.,"Simulation")]*[contains(@class,'alert')]</td>
	<td></td>
</tr>
<tr>
	<td>APPLY_CUSTOM_SIZE</td>
	<td>//button[contains(.,'Apply Custom Size')]</td>
	<td></td>
</tr>

</tbody>
</table>
</body>
</html>