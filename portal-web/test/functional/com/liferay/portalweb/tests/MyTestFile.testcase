@component-name = "portal-web-forms-and-data-lists"
definition {

	property testray.main.component.name = "Forms";

	setUp {
		task ("Set up Portal Instance") {
			TestCase.setUpPortalInstance();
		}

		task ("Perform First Login") {
			User.firstLoginPG();
		}

		task ("Open URL") {
			Navigator.openURL();
		}
	}

	tearDown {
		User.logoutAndLoginPG(
			userLoginEmailAddress = "test@liferay.com",
			userLoginFullName = "Test Test");
	}

	@description = "Set Screen size to custom and validate values"
	@priority = 5
	test SetScreenSizeAndValidateValues {
		task ("Given the simulation is open") {
			Click.waitForMenuToggleJSClick(locator1 = "ControlMenu#SIMULATION");

			Click(
				key_deviceType = "Custom",
				locator1 = "ControlMenuPreviewPanel#PREVIEW_DATA_DEVICE_BUTTON");
		}

		task ("When the Simulation menu is opened and custom screen size is selected") {
			var width = 1088;
			var height = 1922;

			TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD");

			Type.sendKeys(
				locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_HEIGHT_FIELD",
				value1 = ${height});

			TripleClick(locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD");

			Type.sendKeys(
				locator1 = "ControlMenuPreviewPanel#PREVIEW_CUSTOM_WIDTH_FIELD",
				value1 = ${width});

			Click(locator1 = "MyTests#APPLY_CUSTOM_SIZE");
		}

		task ("And the Simulation menu is closed") {
			Click(locator1 = "MyTests#CLOSE_SIMULATION");
		}

		task ("And the Simulation menu is opened again") {
			Click.waitForMenuToggleJSClick(locator1 = "ControlMenu#SIMULATION");

			Click(
				key_deviceType = "Custom",
				locator1 = "ControlMenuPreviewPanel#PREVIEW_DATA_DEVICE_BUTTON");
		}

		task ("Then assert that the values defined in step 4 persisted") {
			AssertElementPresent(locator1 = "ControlMenu#SIMULATION");

			Click(locator1 = "ControlMenu#SIMULATION");

			AssertTextEquals(
				locator1 = "MyTests#ALERT",
				value1 = "Custom Size  ${height}x${width} Applied");
		}
	}

	@description = "Access Portal Global Menu and validate CONFIGURATION string at Control Panel"
	@priority = 5
	test ValidateConfigurationStringAtControlPanel {
		task ("Given the application menu is open") {
			ApplicationsMenuHelper.openApplicationsMenu();
		}

		task ("When the Application Menu is opened and Control Panel is accessed") {
			ApplicationsMenu.gotoPanel(
				category = "Configuration",
				panel = "Control Panel");
		}

		task ("Then validate that the 'CONFIGURATION' section is displayed") {
			AssertElementPresent(locator1 = "MyTests#CONFIGURATION");
		}
	}

}